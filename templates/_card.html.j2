{% macro card(l) -%}
<article class="card">
  <div class="card-top">
    <span class="card-rank">{{ l.rank_s }}</span>
    {%- if l.url %}<a href="{{ l.url }}" class="card-view-link" target="_blank" rel="noopener">View →</a>{% endif %}
  </div>
  <div class="card-price">{{ l.price_s }} <span class="card-price-sub">velaton</span></div>
  {%- if l.monthly_str %}
  <div class="card-monthly">{{ l.monthly_str }}</div>
  {%- endif %}
  {%- if l.yield_str %}
  <div class="card-yield">📈 {{ l.yield_str }}</div>
  {%- endif %}
  <div class="card-loan">{{ l.loan_s }}</div>
  <div class="card-meta">{{ l.meta_s }}</div>
  <div class="card-address">
    {%- if l.url %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.full_addr }}</a>{% else %}{{ l.full_addr }}{% endif -%}
  </div>
  {%- if l.hub_line %}
  <div class="card-hub">{{ l.hub_line }}</div>
  {%- endif %}
  {%- if l.mall_line %}
  <div class="card-hub">{{ l.mall_line }}</div>
  {%- endif %}
  <div class="card-divider"></div>
  <div class="card-badges">
    {%- for b in l.badges %}<span class="badge {{ b.cls }}">{{ b.text }}</span>{% endfor -%}
  </div>
  {%- if l.note %}
  <p class="stop-note">{{ l.note.text }}
    {%- for link in l.note.links %} <a href="{{ link.url }}" class="stop-link" target="_blank" rel="noopener">{{ link.label }}</a>{% endfor -%}
  </p>
  {%- endif %}
  {%- if l.flags %}
  <ul class="risk-flags">
    {%- for f in l.flags %}
    <li><span class="rf-text">{{ f.text }}</span><a href="{{ f.url }}" class="rf-link" target="_blank" rel="noopener">{{ f.label }}</a></li>
    {%- endfor %}
  </ul>
  {%- endif %}
  {%- if l.reno %}
  <p class="reno-note">{{ l.reno }}</p>
  {%- endif %}
</article>
{%- endmacro %}
