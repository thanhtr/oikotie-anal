{% import "_card.html.j2" as cardm %}
{% import "_table.html.j2" as tablem %}
{% import "_market_risks.html.j2" as riskm %}
<!DOCTYPE html>
<html lang="fi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Oikotie — asuntoanalyysi</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="icon" href="icons/icon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="theme-color" content="#1565c0" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#14151c" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Oikotie asunnot">
<link rel="stylesheet" href="report.css">
</head>
<body>
<div class="mode-nav">
  <button class="mode-btn active" onclick="showMode('tram', this)">🚋 Vantaan Ratikka</button>
  <button class="mode-btn" onclick="showMode('uusimaa', this)">🏘 PKS Vuokratut</button>
  <button class="mode-btn" onclick="showMode('newbuild', this)">🏗 PKS Uutuudet</button>
  <button id="install-btn" class="install-btn" hidden>⬇ Install</button>
</div>

<!-- ═══════════════════════════════════════════════════════ TRAM VIEW -->
<div id="mode-tram">
<header>
  <h1>Oikotie — asunnot lähellä Vantaan ratikkaa</h1>
  <p>Generated {{ run_time }} &nbsp;·&nbsp;
     {{ rented_count }} rented out &nbsp;·&nbsp;
     {{ new_count }} new builds &nbsp;·&nbsp;
     {{ pipe_count }} pipe reno done &nbsp;·&nbsp;
     {{ cand_count }} candidates &nbsp;·&nbsp;
     ranked by score</p>
</header>
<div class="criteria">
  <strong>Filters:</strong>
  Free-market (habitationType=1) · velaton hinta ≤ {{ "{:,}".format(price_max) }} € ·
  loan ≤ {{ loan_ratio_max_pct }}% of debt-free price ·
  Built ≥ 2000 <em>or</em> older with completed pipe renovation ·
  1980–1995 builds without confirmed pipe reno excluded ·
  ≤ {{ max_stop_dist_m }} m from a tram stop
</div>
{{ riskm.risks("⚠️ Market & project risk factors (click to expand)", tram_market_risks) }}
<div class="tabs">
  <button class="tab-btn active" onclick="showTab('tram-cards','mode-tram',this)">Cards</button>
  <button class="tab-btn" onclick="showTab('tram-table','mode-tram',this)">Table / Analysis</button>
</div>
<div id="tab-tram-cards" class="tab-panel active">
  {% for sec in tram_sections %}
  <section class="sec {{ sec.cls }}">
    <h2 class="sec-title">{{ sec.title }} <span class="sec-count">({{ sec.count }})</span></h2>
    {% if sec.note %}<p class="sec-note">{{ sec.note }}</p>{% endif %}
    <div class="grid">
      {%- if sec.cards %}{% for l in sec.cards %}{{ cardm.card(l) }}{% endfor %}{% else %}<p class="empty">None this run.</p>{% endif -%}
    </div>
  </section>
  {% endfor %}
</div>
<div id="tab-tram-table" class="tab-panel">
  <div class="tbl-wrap">
    <table id="tram-table">
      <thead>{{ tablem.headers("tram-table", "tram") }}</thead>
      <tbody>{% for row in tram_table_rows %}{{ tablem.row(row) }}{% endfor %}</tbody>
    </table>
  </div>
</div>
</div><!-- /mode-tram -->

<!-- ═══════════════════════════════════════════════════ UUSIMAA VIEW -->
<div id="mode-uusimaa" style="display:none">
<header>
  <h1>Oikotie — sijoitusasunnot PKS (Helsinki · Espoo · Vantaa)</h1>
  <p>Generated {{ run_time }} &nbsp;·&nbsp;
     {{ uusimaa_rented_count }} rented out (all shown) &nbsp;·&nbsp;
     {{ uusimaa_top5_count }} unrented watch list &nbsp;·&nbsp;
     scored: hub · central · mall · quality</p>
</header>
<div class="criteria">
  <strong>Filters:</strong>
  Free-market · velaton hinta ≤ {{ "{:,}".format(uusimaa_price_max) }} € ·
  loan ≤ {{ uusimaa_loan_ratio_max_pct }}% · Built ≥ 2000 <em>or</em> older with pipe reno ·
  1980–1995 without confirmed reno excluded ·
  Rented-out: all shown &nbsp;·&nbsp; Unrented: top {{ uusimaa_top_unrented }} by score ·
  🚋 tram badge if ≤ {{ max_stop_dist_m }} m from Vantaan ratikka stop
</div>
{{ riskm.risks("📊 PKS market signals & risks (click to expand)", uusimaa_market_risks) }}
<div class="tabs">
  <button class="tab-btn active" onclick="showTab('uu-cards','mode-uusimaa',this)">Cards</button>
  <button class="tab-btn" onclick="showTab('uu-table','mode-uusimaa',this)">Table / Analysis</button>
</div>
<div id="tab-uu-cards" class="tab-panel active">
  {% for sec in uu_sections %}
  <section class="sec {{ sec.cls }}">
    <h2 class="sec-title">{{ sec.title }} <span class="sec-count">({{ sec.count }})</span></h2>
    {% if sec.note %}<p class="sec-note">{{ sec.note }}</p>{% endif %}
    <div class="grid">
      {%- if sec.cards %}{% for l in sec.cards %}{{ cardm.card(l) }}{% endfor %}{% else %}<p class="empty">None this run.</p>{% endif -%}
    </div>
  </section>
  {% endfor %}
</div>
<div id="tab-uu-table" class="tab-panel">
  <div class="tbl-wrap">
    <table id="uu-table">
      <thead>{{ tablem.headers("uu-table", "uusimaa") }}</thead>
      <tbody>{% for row in uu_table_rows %}{{ tablem.row(row) }}{% endfor %}</tbody>
    </table>
  </div>
</div>
</div><!-- /mode-uusimaa -->

<!-- ════════════════════════════════════════════ NEW BUILD VIEW -->
<div id="mode-newbuild" style="display:none">
<header>
  <h1>Oikotie — Uudisasunnot PKS (Helsinki · Espoo · Vantaa)</h1>
  <p>{{ newbuild_count }} listings &nbsp;·&nbsp;
     velaton hinta ≤ {{ "{:,}".format(uusimaa_price_max) }} € · loan ≤ {{ uusimaa_loan_ratio_max_pct }}% ·
     Sorted by hub-proximity score</p>
</header>
<div class="tabs">
  <button class="tab-btn active" onclick="showTab('nb-cards','mode-newbuild',this)">Cards</button>
  <button class="tab-btn" onclick="showTab('nb-table','mode-newbuild',this)">Table / Analysis</button>
</div>
<div id="tab-nb-cards" class="tab-panel active">
  {% for sec in nb_sections %}
  <section class="sec {{ sec.cls }}">
    <h2 class="sec-title">{{ sec.title }} <span class="sec-count">({{ sec.count }})</span></h2>
    {% if sec.note %}<p class="sec-note">{{ sec.note }}</p>{% endif %}
    <div class="grid">
      {%- if sec.cards %}{% for l in sec.cards %}{{ cardm.card(l) }}{% endfor %}{% else %}<p class="empty">None this run.</p>{% endif -%}
    </div>
  </section>
  {% endfor %}
</div>
<div id="tab-nb-table" class="tab-panel">
  <div class="tbl-wrap">
    <table id="nb-table">
      <thead>{{ tablem.headers("nb-table", "uusimaa") }}</thead>
      <tbody>{% for row in nb_table_rows %}{{ tablem.row(row) }}{% endfor %}</tbody>
    </table>
  </div>
</div>
</div><!-- /mode-newbuild -->

<script src="report.js"></script>
</body>
</html>
