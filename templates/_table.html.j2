{% macro row(l) -%}
<tr class="{{ l.row_class }}">
  <td>{{ l.rank_s }}</td>
  <td>{%- if l.url %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.addr }}</a>{% else %}{{ l.addr }}{% endif -%}</td>
  <td>{{ l.district }}</td>
  <td class="num">{{ l.dfp_s }}</td>
  <td class="num">{{ l.loan_s }}</td>
  <td>{{ l.rooms }}h</td>
  <td class="num">{{ l.sqm }}</td>
  <td class="num">{{ l.year }}</td>
  {%- if l.status is defined %}
  <td>{{ l.status }}</td>
  {%- else %}
  <td>{{ l.hub_str }}</td>
  <td class="num">{{ l.score }}</td>
  {%- endif %}
</tr>
{%- endmacro %}

{% macro headers(table_id, mode) -%}
<tr>
  <th onclick="sortTable('{{ table_id }}',0)">Rank</th>
  <th onclick="sortTable('{{ table_id }}',1)">Address</th>
  <th onclick="sortTable('{{ table_id }}',2)">District</th>
  <th onclick="sortTable('{{ table_id }}',3)" class="num">Price</th>
  <th onclick="sortTable('{{ table_id }}',4)" class="num">Loan</th>
  <th onclick="sortTable('{{ table_id }}',5)">Rooms</th>
  <th onclick="sortTable('{{ table_id }}',6)" class="num">m²</th>
  <th onclick="sortTable('{{ table_id }}',7)" class="num">Year</th>
  {%- if mode == 'tram' %}
  <th onclick="sortTable('{{ table_id }}',8)">Status</th>
  {%- else %}
  <th onclick="sortTable('{{ table_id }}',8)">Nearest Hub</th>
  <th onclick="sortTable('{{ table_id }}',9)" class="num">Score</th>
  {%- endif %}
</tr>
{%- endmacro %}
